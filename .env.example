# =============================================================================
#  PIGGY AUTH — Variables de entorno
# =============================================================================

NODE_ENV=production
TZ=America/Bogota
PORT=3000

# --- Base de datos (schema auth del postgres compartido) ---
POSTGRES_HOST=piggy_postgres
POSTGRES_PORT=5432
POSTGRES_DB=piggy
POSTGRES_USER=piggy_user
POSTGRES_PASSWORD=change_me_strong_password

# --- JWT ---
JWT_SECRET=change_me_jwt_secret_openssl_rand_hex_32
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Google OAuth ---
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=https://auth.vadi-technologies.com/api/auth/google/callback

# --- URLs de frontends (para redirección post-login) ---
KIDS_FRONTEND_URL=https://piggy.vadi-technologies.com
PRO_FRONTEND_URL=https://piggy-pro.vadi-technologies.com
FAMILY_FRONTEND_URL=https://piggy-family.vadi-technologies.com
BUSINESS_FRONTEND_URL=https://piggy-business.vadi-technologies.com

# --- CORS ---
CORS_ORIGINS=https://piggy.vadi-technologies.com,https://piggy-pro.vadi-technologies.com,http://localhost:4200,http://localhost:4210
